# A dedicated random secret of at least 32 bytes. Never reuse JWT_SECRET.
RATE_LIMIT_HMAC_SECRET=

# Use `none` when the API is reached directly, or a comma-separated CIDR
# allowlist for the reverse proxies that are allowed to supply X-Forwarded-For.
RATE_LIMIT_TRUST_PROXY=none

# IPv6 subnet used when deriving privacy-preserving IP keys.
RATE_LIMIT_IPV6_SUBNET=56
