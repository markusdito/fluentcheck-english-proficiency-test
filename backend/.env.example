# A dedicated random secret of at least 32 bytes. Never reuse JWT_SECRET.
RATE_LIMIT_HMAC_SECRET=

# Use `none` when the API is reached directly, or a comma-separated CIDR
# allowlist for the reverse proxies that are allowed to supply X-Forwarded-For.
RATE_LIMIT_TRUST_PROXY=none

# IPv6 subnet used when deriving privacy-preserving IP keys.
RATE_LIMIT_IPV6_SUBNET=56

# Explicit deployment topology. Multi-process and multi-instance require a
# shared Redis/Valkey-compatible store; single-process may use MemoryStore.
RATE_LIMIT_TOPOLOGY=single-process
RATE_LIMIT_STORE=memory
RATE_LIMIT_STORE_TIMEOUT_MS=1000

# Required when RATE_LIMIT_STORE=shared. The application does not provision it.
RATE_LIMIT_SHARED_STORE_URL=

# Optional in development; required in production when Google OAuth is enabled.
# Keep the client secret server-only. The URI must end in:
# /backend-api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Optional in development: the backend silently no-ops telemetry delivery when
# the Loki URL is unset. Required in production, together with the username and
# token below, plus an HTTPS OBSERVABILITY_RUNBOOK_URL (see
# docs/runbooks/assessment-initialization-failures.md). The URL must be an
# absolute HTTP(S) base URL without credentials, query, or fragment; the
# client appends /loki/api/v1/push.
OBSERVABILITY_LOKI_URL=

# Grafana Cloud stack user/instance ID and access policy token, configured
# together. The token is never included in event payloads.
OBSERVABILITY_LOKI_USERNAME=
OBSERVABILITY_LOKI_TOKEN=

# Stream labels identifying the emitter. Defaults: fluentcheck-backend and
# NODE_ENV.
OBSERVABILITY_SERVICE_NAME=fluentcheck-backend
OBSERVABILITY_ENVIRONMENT=

# HTTPS link to docs/runbooks/assessment-initialization-failures.md. Required
# in production.
OBSERVABILITY_RUNBOOK_URL=

# Per-delivery timeout in milliseconds: positive integer, at most 10000.
# Delivery is best-effort and never affects initialization behavior.
OBSERVABILITY_TIMEOUT_MS=1000
