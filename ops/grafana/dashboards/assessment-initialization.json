{
  "uid": "assessment-initialization",
  "title": "Assessment initialization",
  "description": "Attempts, failures, failure rate, and failure reasons for manifest-backed Submission initialization. Data comes from the sanitized submission_initialization_failed seam; it never contains student identity, idempotency keys, storage keys, signed URLs, provider errors, credentials, or configuration values.",
  "tags": ["fluentcheck", "assessment", "observability"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "custom",
        "query": "production,staging",
        "current": { "selected": true, "text": "production", "value": "production" },
        "includeAll": false,
        "multi": false,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Initialization attempts",
      "description": "SUBMISSION_INITIALIZATION_ATTEMPTED events emitted when authenticated initialization begins. Denominator for the failure rate.",
      "datasource": { "type": "loki", "uid": "assessment-initialization-loki" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "datasource": { "type": "loki", "uid": "assessment-initialization-loki" },
          "expr": "sum by (environment) (count_over_time({service=\"fluentcheck-backend\", environment=\"$environment\", event=\"SUBMISSION_INITIALIZATION_ATTEMPTED\"}[$__rate_interval]))",
          "legendFormat": "{{environment}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Initialization failures",
      "description": "Sanitized submission_initialization_failed events after rollback, split by the emitted failure event.",
      "datasource": { "type": "loki", "uid": "assessment-initialization-loki" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "datasource": { "type": "loki", "uid": "assessment-initialization-loki" },
          "expr": "sum by (event) (count_over_time({service=\"fluentcheck-backend\", environment=\"$environment\", source=\"submission_initialization_failed\"}[$__rate_interval]))",
          "legendFormat": "{{event}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Initialization failure rate",
      "description": "Failed initializations as a percentage of attempted initializations. A denominator clamp of one avoids divide-by-zero noise when traffic is idle.",
      "datasource": { "type": "loki", "uid": "assessment-initialization-loki" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "datasource": { "type": "loki", "uid": "assessment-initialization-loki" },
          "expr": "100 * sum(count_over_time({service=\"fluentcheck-backend\", environment=\"$environment\", source=\"submission_initialization_failed\"}[$__rate_interval])) / clamp_min(sum(count_over_time({service=\"fluentcheck-backend\", environment=\"$environment\", event=\"SUBMISSION_INITIALIZATION_ATTEMPTED\"}[$__rate_interval])), 1)",
          "legendFormat": "failure rate"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Failures by reason",
      "description": "Allowlisted internalReason values extracted from the sanitized failure payload. UNKNOWN is the fallback for anything outside the allowlist.",
      "datasource": { "type": "loki", "uid": "assessment-initialization-loki" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "datasource": { "type": "loki", "uid": "assessment-initialization-loki" },
          "expr": "sum by (internalReason) (count_over_time({service=\"fluentcheck-backend\", environment=\"$environment\", source=\"submission_initialization_failed\"} | json [$__rate_interval]))",
          "legendFormat": "{{internalReason}}"
        }
      ]
    }
  ]
}
